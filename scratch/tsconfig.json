{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "paths": {
      "drizzle-orm": ["../apps/api/node_modules/drizzle-orm"],
      "drizzle-orm/*": ["../apps/api/node_modules/drizzle-orm/*"]
    }
  },
  "include": ["./**/*.ts"]
}
