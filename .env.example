# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intentflow_db

# API Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=intentflow_super_secret_jwt_key_change_in_production_2026
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Client Web Application
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Client Mobile Application
EXPO_PUBLIC_API_URL=http://localhost:4000

# Email Invitation Provider (Resend, SendGrid, or SMTP)
RESEND_API_KEY=re_123456789_abcdef
SENDGRID_API_KEY=SG.123456789_abcdef
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@intentflow.io
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=IntentFlow <no-reply@intentflow.io>

# SMS Invitation Provider (Twilio)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# File Storage Provider System ('local' | 's3' | 'supabase')
STORAGE_PROVIDER=local

# AWS S3 / MinIO Storage Configuration (Required if STORAGE_PROVIDER=s3)
S3_BUCKET=intentflow-attachments
S3_REGION=us-east-1
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key

# Supabase Storage Configuration (Required if STORAGE_PROVIDER=supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=intentflow-attachments
